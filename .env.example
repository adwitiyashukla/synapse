# Copy this file to .env and fill in your values.

# ---- Required ----
# Free Gemini API key from https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=your-key-here

# A long random string used to sign JWT tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ---- Provider (optional overrides) ----
# The app talks to any OpenAI-compatible API. Defaults use Google Gemini's
# free tier. To use OpenAI instead, uncomment the block below and set
# OPENAI_API_KEY (a paid key) instead of GEMINI_API_KEY above.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-5.6-luna
# UTILITY_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# AVAILABLE_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol,gpt-4.1,gpt-4o-mini

# ---- Storage (optional overrides) ----
# DATABASE_URL=sqlite+aiosqlite:///./data/synapse.db
# VECTOR_STORE=chroma            # chroma | memory
# CHROMA_DIR=./data/chroma

# ---- RAG tuning (optional) ----
# RERANK_ENABLED=true
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# FINAL_TOP_K=5

# ---- Server (optional) ----
# CORS_ORIGINS=http://localhost:5173,http://localhost:8000
# DEBUG=false
